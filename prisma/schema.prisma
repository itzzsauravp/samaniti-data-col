generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Municipality {
  id        String               @id @default(uuid())
  code      String               @unique
  nameNe    String               @map("name_ne")
  nameEn    String               @map("name_en")
  province  String
  district  String
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  profile   MunicipalityProfile?
  notices   Notice[]
  projects  Project[]
  reports   Report[]
  scraperRuns ScraperRun[]

  @@map("municipalities")
}

model ScraperRun {
  id               String       @id @default(uuid())
  municipalityCode String       @map("municipality_code")
  province         String
  status           String       @default("running")
  startedAt        DateTime     @default(now()) @map("started_at")
  endedAt          DateTime?    @map("ended_at")
  totalScraped     Int          @default(0) @map("total_scraped")
  projectsCount    Int          @default(0) @map("projects_count")
  reportsCount     Int          @default(0) @map("reports_count")
  noticesCount     Int          @default(0) @map("notices_count")
  errorLog         String?      @map("error_log")
  municipalityId   String       @map("municipality_id")
  municipality     Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  projects         Project[]
  reports          Report[]
  notices          Notice[]

  @@map("scraper_runs")
}

model MunicipalityProfile {
  id             String       @id @default(uuid())
  establishedBs  String?      @map("established_bs")
  totalWards     Int?         @map("total_wards")
  population     Int?
  areaSqKm       Float?       @map("area_sq_km")
  includedVdcsNe String?      @map("included_vdcs_ne")
  email          String?
  website        String?
  facebookPage   String?      @map("facebook_page")
  mobileNo       String?      @map("mobile_no")
  twitterHandle  String?      @map("twitter_handle")
  totalSchools   Int?         @map("total_schools")
  municipalityId String       @unique @map("municipality_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("municipality_profiles")
}

model Project {
  id             String       @id @default(uuid())
  municipalityId String       @map("municipality_id")
  titleNe        String       @map("title_ne")
  titleEn        String?      @map("title_en")
  budgetAmount   Decimal?     @map("budget_amount")
  fiscalYear     String?      @map("fiscal_year")
  status         String?
  wardNo         Int?         @map("ward_no")
  type           String?
  sourceUrl      String       @unique @map("source_url")
  metadata       Json?        @map("metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  runId          String?      @map("run_id")
  scraperRun     ScraperRun?  @relation(fields: [runId], references: [id])
  documents      Document[]
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Report {
  id             String       @id @default(uuid())
  municipalityId String       @map("municipality_id")
  titleNe        String       @map("title_ne")
  titleEn        String?      @map("title_en")
  type           String?
  fiscalYear     String?      @map("fiscal_year")
  publishedDate  String?      @map("published_date")
  sourceUrl      String       @unique @map("source_url")
  metadata       Json?        @map("metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  runId          String?      @map("run_id")
  scraperRun     ScraperRun?  @relation(fields: [runId], references: [id])
  documents      Document[]
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Notice {
  id             String       @id @default(uuid())
  municipalityId String       @map("municipality_id")
  titleNe        String       @map("title_ne")
  titleEn        String?      @map("title_en")
  contentNe      String?      @map("content_ne")
  type           String?
  publishedDate  String?      @map("published_date")
  sourceUrl      String       @unique @map("source_url")
  metadata       Json?        @map("metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  runId          String?      @map("run_id")
  scraperRun     ScraperRun?  @relation(fields: [runId], references: [id])
  documents      Document[]
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("notices")
}

model Document {
  id             String   @id @default(uuid())
  fileName       String   @map("file_name")
  fileType       String?  @map("file_type")
  originalUrl    String   @unique @map("original_url")
  storagePath    String?  @map("storage_path")
  projectId      String?  @map("project_id")
  reportId       String?  @map("report_id")
  noticeId       String?  @map("notice_id")
  createdAt      DateTime @default(now()) @map("created_at")
  downloadError  String?  @map("download_error")
  downloadStatus String   @default("pending") @map("download_status")
  updatedAt      DateTime @updatedAt @map("updated_at")
  notice         Notice?  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  report         Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("documents")
}
