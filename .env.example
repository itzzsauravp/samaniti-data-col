DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'

# If running the scrapper locally by downloading the page itself as html
# Save the mock pages under the mock-pages/ folder and look up their names as how to and what to save them as in `extract.ts` file
USE_MOCK=true

SKIP_FILE_DOWNLOADS=false

# Increase this time if experiencing timeouts when downloading files
FILE_DOWNLOAD_TIMEOUT_MS=60000

# Comma-separated keyword filters applied to scraped item titles (and notice content) during transform.
# INCLUDE_KEYWORDS: keep an item only if its text contains ANY of these keywords (empty = keep all).
# EXCLUDE_KEYWORDS: always drop an item if its text contains ANY of these keywords (exclude wins).
# A site config can override these per-site via keywordFilter.
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=

# Write a readable Nepali transcript (.txt) of each run's records to EXPORT_TXT_DIR.
# Useful for citizens without internet/database access. Disabled by default.
EXPORT_TXT=false
EXPORT_TXT_DIR=storage/export

# --- PDF text extraction / OCR ---
# Documents with fewer than PDF_TEXT_MIN_CHARS meaningful characters fall back to OCR.
PDF_TEXT_MIN_CHARS=80
# Tesseract languages (comma/"+" separated). Traineddata must exist in TESSDATA_DIR.
TESSERACT_LANG=nep+eng
# Directory containing <lang>.traineddata files (shipped: nep, eng).
TESSDATA_DIR=assets/tessdata
# Rasterization scale factor for OCR (higher = sharper but slower).
PDF_OCR_ZOOM=3
# How many pending documents `npm run extract:pdfs` processes per invocation.
PDF_EXTRACT_LIMIT=10

# --- Scheduled scraping ---
# Backend in-process cron (node-cron). Enable to run scrapes on a schedule.
CRON_ENABLED=false
# Cron expression (default: 02:00 daily).
SCRAPE_CRON=0 2 * * *
# Optional IANA timezone (e.g. Asia/Kathmandu).
SCRAPE_CRON_TZ=Asia/Kathmandu
# Comma-separated municipality codes to scrape on schedule (empty = all enabled).
SCRAPE_CRON_SITES=
# Run PDF text extraction/OCR automatically after each scheduled scrape.
SCRAPE_EXTRACT_PDFS=false
